# Existing secret .env lives at the repository root. Never copy real values here.
FLASK_APP=app:create_app
APP_ENV=development
FLASK_SECRET_KEY=
LOCAL_MODE=false
DEMO_MODE=false
FIREBASE_PROJECT_ID=
# Relative credential paths are resolved against the directory containing .env.
# Leave empty on Cloud Run to use Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
# Optional public Firebase web fields, no Analytics SDK is used.
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=
# Optional legacy JSON config; prefer the separate FIREBASE_WEB_* variables above.
FIREBASE_WEB_CONFIG=
GEMINI_API_KEY=
# Required: choose a generateContent model returned by the models API.
GEMINI_MODEL=
LLM_PROVIDER=gemini
ENCRYPTION_KEY=
CRON_SECRET=
PROVIDER_ORDER=syncfy,finerio,simulated
PROFECO_ESTADOS=
PROFECO_MUNICIPIOS=
RADIO_KM=5
DONATION_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
